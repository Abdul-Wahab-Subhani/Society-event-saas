# Database
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/society-events

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# Email (Resend)
RESEND_API_KEY=re_xxx
EMAIL_FROM="Society Events <noreply@yourdomain.com>"

# App
NEXT_PUBLIC_APP_URL=https://yourapp.vercel.app

# Automation cron endpoint auth — Vercel Cron sends this as a header;
# reject any request to /api/cron/automation-run that doesn't match.
CRON_SECRET=replace-with-a-long-random-string

# How long after an event's endTime the automation engine waits before
# auto-completing it (see lib/automation/actions/autoComplete.ts)
AUTO_COMPLETE_BUFFER_HOURS=1

# Sentry
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
